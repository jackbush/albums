---
import { Picture } from 'astro:assets';
import { fullPlate, isGif } from '../../lib/media';
import { groupRows } from '../../lib/layout';
import type { GroupImage } from '../../lib/schema';
import { blockMarker } from '../../lib/dev';

interface Props {
  images: GroupImage[];
  caption?: string;
  /** Plate number of the first frame; the rest follow in order. */
  plate: number;
  /** Position in the manifest, shown only by the dev server. */
  block: number;
}

const { images, caption, plate, block } = Astro.props;

const labels = images.map((_, i) => String(plate + i).padStart(2, '0'));
const marker = blockMarker(block);

// The content column is 1052px wide; frames in a row split it, less the gutters.
const CONTENT = 1052;
// The site gutter, which is also the page padding either side of the column: the
// space between two frames and the space to the page edge are the same 1rem.
const GAP = 16;
const PADDING = '2rem';
// Small rungs for a frame sharing a row on desktop, large ones for the same frame
// running full width below 720px, where a DPR-3 phone asks for around 1030.
const WIDTHS = [250, 375, 550, 825, 1160, 1530];

const frames = await Promise.all(
  images.map(async (image, i) => ({
    ...image,
    label: labels[i],
    gif: isGif(image.src),
    full: await fullPlate(image.src),
    // Caps `Picture`'s fallback <img> at the widest rung — see ImageItem.
    fallback: Math.min(image.src.width, 1530),
    // Frame widths in proportion to each frame's aspect ratio: the frames in a row
    // then land on a common height and fill it exactly, without any being cropped.
    ratio: image.src.width / image.src.height,
  })),
);

/**
 * A frame's share of its row, and the gutters that row spends, under one set of row
 * shapes. Keyed by frame index, alongside whether the row ends after that frame.
 */
function share(variant: 'wide' | 'narrow') {
  const shares: { share: number; gaps: number; ends: boolean }[] = [];

  let start = 0;
  for (const count of groupRows(frames.length, variant)) {
    const inRow = frames.slice(start, start + count);
    const total = inRow.reduce((sum, frame) => sum + frame.ratio, 0);
    inRow.forEach((frame, i) => {
      shares.push({
        share: frame.ratio / total,
        gaps: GAP * (count - 1),
        ends: i === count - 1,
      });
    });
    start += count;
  }

  return shares;
}

const wide = share('wide');
const narrow = share('narrow');

const laid = frames.map((frame, i) => ({
  ...frame,
  wide: wide[i],
  narrow: narrow[i],
  // A break after the last frame would only add an empty row.
  breaks: {
    wide: wide[i].ends && i < frames.length - 1,
    narrow: narrow[i].ends && i < frames.length - 1,
  },
  sizes: [
    `(max-width: 719px) calc((100vw - (${PADDING} + ${narrow[i].gaps}px)) * ${narrow[i].share.toFixed(4)})`,
    `(min-width: 67.75rem) ${Math.round((CONTENT - wide[i].gaps) * wide[i].share)}px`,
    `calc((100vw - (${PADDING} + ${wide[i].gaps}px)) * ${wide[i].share.toFixed(4)})`,
  ].join(', '),
  style: [
    `--share-wide: ${wide[i].share.toFixed(4)}`,
    `--gaps-wide: ${wide[i].gaps}px`,
    `--share-narrow: ${narrow[i].share.toFixed(4)}`,
    `--gaps-narrow: ${narrow[i].gaps}px`,
  ].join('; '),
}));
---

<figure class="group">
  <div class="group__frames">
    {
      laid.map((frame) => (
        <>
          <div
            class="group__frame"
            style={frame.style}
            data-lightbox
            data-full={frame.full.src}
            data-full-width={frame.full.width}
            data-full-height={frame.full.height}
            data-alt={frame.alt}
            data-caption={caption}
            data-plate={frame.label}
          >
            <button
              type="button"
              class="group__open"
              aria-label={frame.alt ? `View full screen: ${frame.alt}` : `View plate ${frame.label} full screen`}
            >
              {frame.gif ? (
                <img
                  src={frame.src.src}
                  width={frame.src.width}
                  height={frame.src.height}
                  alt={frame.alt ?? ''}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <Picture
                  src={frame.src}
                  alt={frame.alt ?? ''}
                  width={frame.fallback}
                  widths={WIDTHS}
                  sizes={frame.sizes}
                  formats={['avif', 'webp']}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </button>
          </div>
          {frame.breaks.wide && <span class="group__break group__break--wide" aria-hidden="true" />}
          {frame.breaks.narrow && <span class="group__break group__break--narrow" aria-hidden="true" />}
        </>
      ))
    }
  </div>
  {
    (caption || marker) && (
      <figcaption class="group__caption">
        {caption && <span class="meta group__text">{caption}</span>}
        {marker && <span class="meta block-marker">{marker}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  /*
   * One flow of frames rather than a div per row: the rows a phone wants aren't the
   * rows a desktop wants, and the same frames can't sit in two sets of parents. A
   * full-width, zero-height break element ends a row, and each breakpoint shows only
   * its own breaks. Row spacing is two of the flex row-gaps — one either side of the
   * break — so the row-gap is half the gutter, leaving rows and columns the same
   * 1rem apart.
   */
  .group__frames {
    --gutter: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--gutter) / 2) var(--gutter);
    align-items: flex-start;
  }

  .group__frame {
    --share: var(--share-wide);
    --gaps: var(--gaps-wide);
    /* The half-pixel keeps rounding from pushing a row's last frame onto its own line. */
    width: calc((100% - var(--gaps) - 0.5px) * var(--share));
  }

  .group__break {
    flex-basis: 100%;
    height: 0;
  }

  .group__break--narrow {
    display: none;
  }

  .group__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .group__open :global(img) {
    width: 100%;
  }

  /* One caption for the whole group, where a single plate's caption sits. */
  .group__caption {
    margin-top: 0.7rem;
  }

  .group__text {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 0.8125rem;
    font-weight: 400;
  }

  /* On a phone the rows run no more than two across. */
  @media (max-width: 719px) {
    .group__frame {
      --share: var(--share-narrow);
      --gaps: var(--gaps-narrow);
    }

    .group__break--wide {
      display: none;
    }

    .group__break--narrow {
      display: block;
    }
  }
</style>
