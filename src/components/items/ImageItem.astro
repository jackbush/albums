---
import { Picture } from 'astro:assets';
import { fullPlate, isGif } from '../../lib/media';
import { blockMarker } from '../../lib/dev';

interface Props {
  src: ImageMetadata;
  alt?: string;
  plate: number;
  /** Position in the manifest, shown only by the dev server. */
  block: number;
}

const { src, alt = '', plate, block } = Astro.props;
const label = String(plate).padStart(2, '0');
const marker = blockMarker(block);

// The container is 1084px wide with 16px of padding, so 1052px is the display width.
const SIZES = '(min-width: 67.75rem) 1052px, calc(100vw - 2rem)';

// Rungs are spaced ~1.4x so no viewport overshoots by much. 825 is the DPR-2 phone,
// 1160 the DPR-3 phone (a 390px screen asks for 1026, which a 1052 rung would cover
// but only just), 1052/2104 the column at 1x and 2x.
const WIDTHS = [550, 825, 1160, 1600, 2104];

// Caps `Picture`'s fallback <img>, which otherwise renders at the source's full size —
// a 5MB frame from a 6000px original, plus an unreferenced avif and webp beside it.
const FALLBACK = Math.min(src.width, 2104);

const gif = isGif(src);
const full = await fullPlate(src);
---

<figure
  class="plate"
  data-lightbox
  data-full={full.src}
  data-full-width={full.width}
  data-full-height={full.height}
  data-alt={alt}
  data-plate={label}
>
  <button type="button" class="plate__open" aria-label={alt ? `View full screen: ${alt}` : `View plate ${label} full screen`}>
    {
      gif ? (
        <img src={src.src} width={src.width} height={src.height} alt={alt} loading="lazy" decoding="async" />
      ) : (
        <Picture
          src={src}
          alt={alt}
          width={FALLBACK}
          widths={WIDTHS}
          sizes={SIZES}
          formats={['avif', 'webp']}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </button>
  {
    (alt || marker) && (
      <figcaption class="plate__caption">
        {alt && <span class="meta plate__alt">{alt}</span>}
        {marker && <span class="meta block-marker">{marker}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .plate__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .plate__open :global(img) {
    width: 100%;
  }

  /* Plain inline flow, so a dev block marker trails the last word of the caption. */
  .plate__caption {
    margin-top: 0.7rem;
  }

  .plate__alt {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 0.8125rem;
    font-weight: 400;
  }

</style>
