---
import { getImage } from 'astro:assets';
import { blockMarker } from '../../lib/dev';

interface Props {
  /** Already resolved to an asset URL by lib/posts.ts. */
  src: string;
  poster?: ImageMetadata;
  alt?: string;
  loop: boolean;
  muted: boolean;
  autoplay: boolean;
  /** Position in the manifest, shown only by the dev server. */
  block: number;
}

const { src: source, poster, alt, loop, muted, autoplay, block } = Astro.props;
const marker = blockMarker(block);

const posterImage = poster ? await getImage({ src: poster, width: 1530, format: 'webp' }) : null;

// Browsers refuse to autoplay with sound, so autoplay implies muted rather than
// silently doing nothing. An autoplaying loop is ambient, so it loses its controls.
const isAmbient = autoplay;
const type = source.endsWith('.webm') ? 'video/webm' : 'video/mp4';
---

<figure class="film">
  <video
    controls={!isAmbient}
    loop={loop || isAmbient}
    muted={muted || isAmbient}
    autoplay={isAmbient}
    playsinline
    preload={isAmbient ? 'auto' : 'metadata'}
    poster={posterImage?.src}
    aria-label={alt}
  >
    <source src={source} type={type} />
    Your browser can't play this video.
  </video>
  <figcaption class="film__caption">
    <span class="meta film__label">Film</span>
    {alt && <span class="meta film__alt">{alt}</span>}
    {marker && <span class="meta block-marker">{marker}</span>}
  </figcaption>
</figure>

<style>
  .film video {
    width: 100%;
    background: var(--rule);
  }

  .film__caption {
    margin-top: 0.7rem;
  }

  /* Films aren't plates — the label says so where a caption would otherwise start. */
  .film__label {
    color: var(--accent);
    margin-right: 0.9rem;
  }

  .film__alt {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 0.8125rem;
    font-weight: 400;
  }
</style>
