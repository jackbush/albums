---
import { Picture } from 'astro:assets';
import { fullPlate, isGif } from '../../lib/media';
import { photoRows } from '../../lib/layout';
import type { Photo } from '../../lib/schema';
import { blockMarker } from '../../lib/dev';

interface Props {
  images: Photo[];
  caption?: string;
  /** Gives the first frame a full-width row of its own, at every width. */
  hero: boolean;
  /** Plate number of the first frame; the rest follow in order. */
  plate: number;
  /** Position in the manifest, shown only by the dev server. */
  block: number;
}

const { images, caption, hero, plate, block } = Astro.props;

const labels = images.map((_, i) => String(plate + i).padStart(2, '0'));
const marker = blockMarker(block);

// The content column is 1168px wide; frames in a row split it, less the gutters.
const CONTENT = 1168;
// The site gutter, which is also the page padding either side of the column: the
// space between two frames and the space to the page edge are the same 1rem.
const GAP = 16;
const PADDING = '2rem';

// Two sets of rungs, picked per frame by how wide that frame ever gets. A frame
// alone on its row holds the whole column, so it needs the column at 2x (2336);
// 830 is the DPR-2 phone, 1180 both the DPR-3 phone and the column at 1x, 1650 the
// tablet at 2x. A frame sharing a row never exceeds half the column on desktop, so
// it stops at 1650 — which still covers it running full width below 720px.
const FULL_WIDTHS = [560, 830, 1180, 1650, 2336];
const ROW_WIDTHS = [250, 380, 580, 830, 1180, 1650];

/**
 * A frame's share of its row, the gutters that row spends, how many frames the row
 * holds, and whether the row ends after it. Keyed by frame index, under one set of
 * row shapes.
 */
function share(variant: 'wide' | 'narrow') {
  const shares: { share: number; gaps: number; count: number; ends: boolean }[] = [];
  const ratios = images.map((image) => image.src.width / image.src.height);

  let start = 0;
  for (const count of photoRows(images.length, variant, hero)) {
    const inRow = ratios.slice(start, start + count);
    const total = inRow.reduce((sum, ratio) => sum + ratio, 0);
    // Frame widths in proportion to each frame's aspect ratio: the frames in a row
    // then land on a common height and fill it exactly, without any being cropped.
    inRow.forEach((ratio, i) => {
      shares.push({ share: ratio / total, gaps: GAP * (count - 1), count, ends: i === count - 1 });
    });
    start += count;
  }

  return shares;
}

const wide = share('wide');
const narrow = share('narrow');

const frames = await Promise.all(
  images.map(async (image, i) => {
    // Desktop decides the rungs: it is where a shared row is at its narrowest, and
    // where a lone frame is at its widest.
    const full = wide[i].count === 1;

    return {
      ...image,
      label: labels[i],
      // Each slide repeats the block's caption; the count says which frame of the
      // set you are looking at — "Temples on the river (2/4)". A lone plate has no
      // set to be counted in.
      caption: caption && (images.length > 1 ? `${caption} (${i + 1}/${images.length})` : caption),
      gif: isGif(image.src),
      plate: await fullPlate(image.src),
      widths: full ? FULL_WIDTHS : ROW_WIDTHS,
      // Caps `Picture`'s fallback <img>, which otherwise renders at the source's full
      // size — a 5MB frame from a 6000px original, plus an unreferenced avif and webp.
      fallback: Math.min(image.src.width, full ? 2336 : 1650),
      // A break after the last frame would only add an empty row.
      breaks: {
        wide: wide[i].ends && i < images.length - 1,
        narrow: narrow[i].ends && i < images.length - 1,
      },
      sizes: [
        `(max-width: 719px) calc((100vw - (${PADDING} + ${narrow[i].gaps}px)) * ${narrow[i].share.toFixed(4)})`,
        `(min-width: 75rem) ${Math.round((CONTENT - wide[i].gaps) * wide[i].share)}px`,
        `calc((100vw - (${PADDING} + ${wide[i].gaps}px)) * ${wide[i].share.toFixed(4)})`,
      ].join(', '),
      style: [
        `--share-wide: ${wide[i].share.toFixed(4)}`,
        `--gaps-wide: ${wide[i].gaps}px`,
        `--share-narrow: ${narrow[i].share.toFixed(4)}`,
        `--gaps-narrow: ${narrow[i].gaps}px`,
      ].join('; '),
    };
  }),
);
---

<figure class="photos">
  <div class="photos__frames">
    {
      frames.map((frame) => (
        <>
          <div
            class="photos__frame"
            style={frame.style}
            data-lightbox
            data-full={frame.plate.src}
            data-full-width={frame.plate.width}
            data-full-height={frame.plate.height}
            data-alt={frame.alt}
            data-caption={frame.caption}
            data-plate={frame.label}
          >
            <button
              type="button"
              class="photos__open"
              aria-label={frame.alt ? `View full screen: ${frame.alt}` : `View plate ${frame.label} full screen`}
            >
              {frame.gif ? (
                <img
                  src={frame.src.src}
                  width={frame.src.width}
                  height={frame.src.height}
                  alt={frame.alt ?? ''}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <Picture
                  src={frame.src}
                  alt={frame.alt ?? ''}
                  width={frame.fallback}
                  widths={frame.widths}
                  sizes={frame.sizes}
                  formats={['avif', 'webp']}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </button>
          </div>
          {frame.breaks.wide && <span class="photos__break photos__break--wide" aria-hidden="true" />}
          {frame.breaks.narrow && <span class="photos__break photos__break--narrow" aria-hidden="true" />}
        </>
      ))
    }
  </div>
  {
    (caption || marker) && (
      <figcaption class="photos__caption">
        {caption && <span class="meta photos__text">{caption}</span>}
        {marker && <span class="meta block-marker">{marker}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  /*
   * One flow of frames rather than a div per row: the rows a phone wants aren't the
   * rows a desktop wants, and the same frames can't sit in two sets of parents. A
   * full-width, zero-height break element ends a row, and each breakpoint shows only
   * its own breaks. Row spacing is two of the flex row-gaps — one either side of the
   * break — so the row-gap is half the gutter, leaving rows and columns the same
   * 1rem apart. A block of one is the degenerate case: one row, no breaks, full width.
   */
  .photos__frames {
    --gutter: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--gutter) / 2) var(--gutter);
    align-items: flex-start;
  }

  .photos__frame {
    --share: var(--share-wide);
    --gaps: var(--gaps-wide);
    /* The half-pixel keeps rounding from pushing a row's last frame onto its own line. */
    width: calc((100% - var(--gaps) - 0.5px) * var(--share));
  }

  .photos__break {
    flex-basis: 100%;
    height: 0;
  }

  .photos__break--narrow {
    display: none;
  }

  .photos__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .photos__open :global(img) {
    width: 100%;
  }

  /* One caption for the whole block, however many frames it holds. */
  .photos__caption {
    margin-top: 0.7rem;
  }

  .photos__text {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 0.8125rem;
    font-weight: 400;
  }

  /* On a phone the rows run no more than two across. */
  @media (max-width: 719px) {
    .photos__frame {
      --share: var(--share-narrow);
      --gaps: var(--gaps-narrow);
    }

    .photos__break--wide {
      display: none;
    }

    .photos__break--narrow {
      display: block;
    }
  }
</style>
