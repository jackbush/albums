---
import { blockMarker } from '../../lib/dev';

interface Props {
  text: string;
  attribution?: string;
  attributionLink?: string;
  /** Position in the manifest, shown only by the dev server. */
  block: number;
}

const { text, attribution, attributionLink, block } = Astro.props;
const marker = blockMarker(block);
---

<blockquote class="quote">
  <p class="quote__text">{text}</p>
  {
    attribution && (
      <cite class="meta quote__cite">
        {attributionLink ? <a href={attributionLink}>{attribution}</a> : attribution}
      </cite>
    )
  }
  {marker && <p class="meta block-marker quote__marker">{marker}</p>}
</blockquote>

<style>
  .quote {
    padding: 1.5rem 0;
    /* Pulled in from the plate edge so it reads as an aside, not another plate. */
    margin-inline: auto;
    max-width: 46ch;
    text-align: center;
  }

  .quote__text {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 1.1rem + 1.9vw, 2.25rem);
    font-weight: 400;
    line-height: 1.28;
    letter-spacing: -0.015em;
    color: var(--text-title);
    text-wrap: pretty;
  }

  .quote__cite {
    display: block;
    margin-top: 1.25rem;
    font-style: normal;
  }

  .quote__cite a {
    color: var(--text-link);
  }

  .quote__marker {
    margin-top: 0.75rem;
  }
</style>
