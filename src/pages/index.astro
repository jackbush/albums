---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getListedAlbums, getSite, stamp } from '../lib/posts';
import { url } from '../lib/site';

const site = getSite();
const albums = getListedAlbums();

// Cards are half the 1168px column on desktop, full width below the 768px break.
// The gap between them is the site gutter, so a card is (1168 - 16) / 2.
//
// Three breaks rather than two, because the column count and the bleed don't change
// at the same width: cards go one-up at 768px, but the cover only breaks out to the
// screen edge at 720px, where the rest of the site bleeds. Between the two it is a
// full-width card still sitting inside the page gutter.
const SIZES = [
  '(min-width: 75rem) 576px',
  '(min-width: 48rem) calc(50vw - 1.5rem)',
  '(min-width: 45rem) calc(100vw - 2rem)',
  '100vw',
].join(', ');
// 580 the card at 1x, 1180 at 2x — which also covers a DPR-3 phone on a full-width
// card. Shares its rungs with the plate ladders, so a cover used in both is cut once.
const WIDTHS = [400, 580, 830, 1180, 1650];

// Caps `Picture`'s fallback <img> at the widest rung — see PhotosItem.
const FALLBACK = 1650;
---

<BaseLayout title={site.title} description={site.description} image={site.cover}>
  <header class="container masthead">
    <h1 class="display masthead__mark">{site.heading}</h1>
  </header>

  <main id="main" class="container">
    <ul class="register">
      {
        albums.map((album) => (
          <li class="entry">
            <a class="entry__link" href={url(`${album.slug}/`)}>
              <Picture
                class="entry__cover"
                src={album.cover}
                alt=""
                width={Math.min(album.cover.width, FALLBACK)}
                widths={WIDTHS}
                sizes={SIZES}
                formats={['avif', 'webp']}
                loading="lazy"
                decoding="async"
              />
              <h2 class="display entry__title">{album.title}</h2>
              <p class="meta entry__stamp">{stamp(album)}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  .masthead {
    padding-block: 5rem 2rem;
  }

  .masthead__mark {
    font-size: 2.5rem;
  }

  .register {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    /* The column gap is the site gutter, the same 1rem that separates two frames
       inside a group. The row gap stays wide — a card carries a title and a stamp
       under it, so the rows need more air than the columns. */
    gap: 4rem 1rem;
    padding-bottom: 6rem;
  }

  .entry__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* Covers are cropped to a common ratio so the grid stays even whatever the
     source orientation — portrait covers would otherwise tower over landscape ones. */
  .entry__cover {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .entry__title {
    margin-top: 1.25rem;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2rem);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
    transition: text-decoration-color 140ms ease;
  }

  /* Matches the stamp under an album page's title, one step tighter to sit
     under the smaller card heading. */
  .entry__stamp {
    margin-top: 0.5rem;
    letter-spacing: 0.16em;
  }

  .entry__link:hover .entry__title,
  .entry__link:focus-visible .entry__title {
    text-decoration-color: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .entry__title {
      transition: none;
    }
  }

  /* 768px: cards go full width. */
  @media (max-width: 48rem) {
    .masthead {
      padding-block: 3rem 1.5rem;
    }

    .register {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-bottom: 4rem;
    }
  }

  /*
   * Below 720px a cover breaks out to the screen edge, the way a plate does inside
   * an album, while the title and stamp under it stay on the container's measure.
   * The card stops being a tidy rectangle and becomes a picture with its caption
   * set beneath — which is the same trade the album pages already make.
   *
   * Width is set explicitly instead of using the shared `.bleed` helper. That one
   * only hangs negative margins and lets the element grow into the space they open
   * up, which works for an auto-width box but not for a replaced element already
   * pinned to `width: 100%`.
   */
  @media (max-width: 719px) {
    .entry__cover {
      /* `img { max-width: 100% }` in global.css would otherwise clamp the width
         below back to the container, leaving the negative left margin to pull the
         cover flush left and strand a gutter's worth of gap down the right. */
      max-width: none;
      width: calc(100% + var(--page-gutter) * 2);
      margin-inline: calc(var(--page-gutter) * -1);
    }
  }
</style>
