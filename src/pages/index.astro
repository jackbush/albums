---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getListedAlbums, getSite } from '../lib/posts';
import { url } from '../lib/site';

const site = getSite();
const albums = getListedAlbums();

// Cards are half the 1052px column on desktop, full width below the 768px break.
const SIZES =
  '(min-width: 67.75rem) 506px, (min-width: 48rem) calc(50vw - 2.25rem), calc(100vw - 2rem)';
const WIDTHS = [400, 506, 800, 1012, 1600];

// Caps `Picture`'s fallback <img> at the widest rung — see ImageItem.
const FALLBACK = 1600;
---

<BaseLayout title={site.title} description={site.description} image={site.cover}>
  <header class="container masthead">
    <h1 class="display masthead__mark">{site.heading}</h1>
  </header>

  <main id="main" class="container">
    <ul class="register">
      {
        albums.map((album) => (
          <li class="entry">
            <a class="entry__link" href={url(`${album.slug}/`)}>
              <Picture
                class="entry__cover"
                src={album.cover}
                alt=""
                width={Math.min(album.cover.width, FALLBACK)}
                widths={WIDTHS}
                sizes={SIZES}
                formats={['avif', 'webp']}
                loading="lazy"
                decoding="async"
              />
              <h2 class="display entry__title">{album.title}</h2>
              <p class="entry__description">{album.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  .masthead {
    padding-block: 5rem 2rem;
  }

  .masthead__mark {
    font-size: 2.5rem;
  }

  .register {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4rem 2.5rem;
    padding-bottom: 6rem;
  }

  .entry__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* Covers are cropped to a common ratio so the grid stays even whatever the
     source orientation — portrait covers would otherwise tower over landscape ones. */
  .entry__cover {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .entry__title {
    margin-top: 1.25rem;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2rem);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
    transition: text-decoration-color 140ms ease;
  }

  .entry__description {
    margin-top: 0.4rem;
    color: var(--text-secondary);
  }

  .entry__link:hover .entry__title,
  .entry__link:focus-visible .entry__title {
    text-decoration-color: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .entry__title {
      transition: none;
    }
  }

  /* 768px: cards go full width. */
  @media (max-width: 48rem) {
    .masthead {
      padding-block: 3rem 1.5rem;
    }

    .register {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-bottom: 4rem;
    }
  }
</style>
