---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import NavBar from '../components/NavBar.astro';
import ImageItem from '../components/items/ImageItem.astro';
import GroupItem from '../components/items/GroupItem.astro';
import VideoItem from '../components/items/VideoItem.astro';
import QuoteItem from '../components/items/QuoteItem.astro';
import TextItem from '../components/items/TextItem.astro';
import { getAlbums, getSite, plateCount, withPlateNumbers, type Album } from '../lib/posts';

interface Props {
  album: Album;
}

// Built from the folders, not from index.js, so an unlisted album is still
// reachable by direct URL — that's how you preview one before publishing it.
export const getStaticPaths: GetStaticPaths = () =>
  [...getAlbums().values()].map((album) => ({
    params: { slug: album.slug },
    props: { album },
  }));

const { album } = Astro.props;
const { title, description, date, cover, items, theme } = album;

const site = getSite();
const plates = plateCount(items);
const blocks = withPlateNumbers(items);

// Title, description and share image all come from the manifest, so editing it
// updates the page, the home page card and the link preview together.
const pageTitle = `${title} — ${site.heading}`;
---

<BaseLayout title={pageTitle} description={description} image={cover} theme={theme}>
  <NavBar />

  <main id="main" class="container post">
    <div class="post__head">
      <h1 class="display post__title">{title}</h1>
      <p class="post__description">{description}</p>
      <p class="meta post__meta">{date}</p>
      <hr class="rule post__rule" />
    </div>

    <div class="post__body">
      {
        blocks.map(({ item, plate }) => {
          switch (item.type) {
            case 'image':
              return <ImageItem src={item.src} alt={item.alt} plate={plate!} />;
            case 'group':
              return <GroupItem images={item.images} caption={item.caption} plate={plate!} />;
            case 'video':
              return (
                <VideoItem
                  src={item.src}
                  poster={item.poster}
                  alt={item.alt}
                  loop={item.loop}
                  muted={item.muted}
                  autoplay={item.autoplay}
                />
              );
            case 'quote':
              return (
                <QuoteItem
                  text={item.text}
                  attribution={item.attribution}
                  attributionLink={item.attributionLink}
                />
              );
            case 'text':
              return <TextItem text={item.text} />;
          }
        })
      }
    </div>
  </main>

  <NavBar as="footer" />

  {plates > 0 && <Lightbox />}
</BaseLayout>

<style>

  .post__head {
    padding-block: 7rem 3rem;
  }

  .post__title {
    font-size: clamp(3.375rem, 2.1rem + 5.1vw, 6rem);
  }

  .post__description {
    margin-top: 0.5rem;
    max-width: 34ch;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2rem);
    line-height: 1.25;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .post__meta {
    margin-top: 1rem;
  }

  .post__rule {
    margin-top: 2.5rem;
    border-top-width: 2px;
  }

  /* One rhythm for every block type, so the column reads as a single sequence. */
  .post__body {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    padding-bottom: 5rem;
  }

  @media (max-width: 48rem) {
    .post__head {
      padding-block: 2.5rem 2rem;
    }

    .post__body {
      gap: 3rem;
      padding-bottom: 3.5rem;
    }
  }
</style>
