---
import { Picture, getImage } from 'astro:assets';
import { isGif } from '../../lib/media';

interface Props {
  src: ImageMetadata;
  alt?: string;
  plate: number;
}

const { src, alt = '', plate } = Astro.props;
const label = String(plate).padStart(2, '0');

// The container is 1100px wide with 40px of padding, so 1020px is the display width.
const SIZES = '(min-width: 68.75rem) 1020px, calc(100vw - 3rem)';
const WIDTHS = [550, 825, 1020, 1530, 2040];

const gif = isGif(src);

// The plate shown in the lightbox. Animated GIFs bypass sharp entirely — resizing one
// drops every frame but the first — and still get a hashed URL from the import.
const fullWidth = gif ? src.width : Math.min(src.width, 2400);
const fullHeight = Math.round(src.height * (fullWidth / src.width));
const fullSrc = gif
  ? src.src
  : (await getImage({ src, width: fullWidth, format: 'webp', quality: 82 })).src;
---

<figure
  class="plate"
  data-lightbox
  data-full={fullSrc}
  data-full-width={fullWidth}
  data-full-height={fullHeight}
  data-alt={alt}
  data-plate={label}
>
  <button type="button" class="plate__open" aria-label={alt ? `View full screen: ${alt}` : `View plate ${label} full screen`}>
    {
      gif ? (
        <img src={src.src} width={src.width} height={src.height} alt={alt} loading="lazy" decoding="async" />
      ) : (
        <Picture
          src={src}
          alt={alt}
          widths={WIDTHS}
          sizes={SIZES}
          formats={['avif', 'webp']}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </button>
  <figcaption class="plate__caption">
    <span class="meta plate__no">{label}</span>
    {alt && <span class="meta plate__alt">{alt}</span>}
    <span class="meta plate__hint" aria-hidden="true">Expand</span>
  </figcaption>
</figure>

<style>
  .plate__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .plate__open :global(img) {
    width: 100%;
  }

  .plate__caption {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding-top: 0.7rem;
    margin-top: 0.7rem;
    border-top: 1px solid var(--rule);
  }

  /* The plate number is the one coloured mark in the page chrome. */
  .plate__no {
    color: var(--accent);
    flex: none;
  }

  .plate__alt {
    flex: 1;
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 0.8125rem;
    font-weight: 400;
  }

  .plate__hint {
    margin-left: auto;
    flex: none;
    color: var(--text-secondary);
    opacity: 0;
    transition: opacity 140ms ease;
  }

  .plate:hover .plate__hint,
  .plate__open:focus-visible ~ .plate__caption .plate__hint {
    opacity: 0.7;
  }

  @media (hover: none) {
    .plate__hint {
      display: none;
    }
  }
</style>
