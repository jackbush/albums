---
import { Picture } from 'astro:assets';
import { fullPlate, isGif } from '../../lib/media';

interface Props {
  src: ImageMetadata;
  alt?: string;
  plate: number;
}

const { src, alt = '', plate } = Astro.props;
const label = String(plate).padStart(2, '0');

// The container is 1100px wide with 40px of padding, so 1020px is the display width.
const SIZES = '(min-width: 68.75rem) 1020px, calc(100vw - 3rem)';

// Rungs are spaced ~1.4x so no viewport overshoots by much. 825 is the DPR-2 phone,
// 1160 the DPR-3 phone (a 390px screen asks for 1026, which a 1020 rung would miss by
// six pixels, bumping it to the next one up), 1020/2040 the column at 1x and 2x.
const WIDTHS = [550, 825, 1160, 1600, 2040];

// Caps `Picture`'s fallback <img>, which otherwise renders at the source's full size —
// a 5MB frame from a 6000px original, plus an unreferenced avif and webp beside it.
const FALLBACK = Math.min(src.width, 2040);

const gif = isGif(src);
const full = await fullPlate(src);
---

<figure
  class="plate"
  data-lightbox
  data-full={full.src}
  data-full-width={full.width}
  data-full-height={full.height}
  data-alt={alt}
  data-plate={label}
>
  <button type="button" class="plate__open" aria-label={alt ? `View full screen: ${alt}` : `View plate ${label} full screen`}>
    {
      gif ? (
        <img src={src.src} width={src.width} height={src.height} alt={alt} loading="lazy" decoding="async" />
      ) : (
        <Picture
          src={src}
          alt={alt}
          width={FALLBACK}
          widths={WIDTHS}
          sizes={SIZES}
          formats={['avif', 'webp']}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </button>
  <figcaption class="plate__caption">
    <span class="meta plate__no">{label}</span>
    {alt && <span class="meta plate__alt">{alt}</span>}
  </figcaption>
</figure>

<style>
  .plate__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .plate__open :global(img) {
    width: 100%;
  }

  .plate__caption {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-top: 0.7rem;
  }

  /* The plate number is the one coloured mark in the page chrome. */
  .plate__no {
    color: var(--accent);
    flex: none;
  }

  .plate__alt {
    flex: 1;
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 0.8125rem;
    font-weight: 400;
  }

</style>
