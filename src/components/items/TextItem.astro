---
import { blockMarker } from '../../lib/dev';

interface Props {
  text: string;
  /** Position in the manifest, shown only by the dev server. */
  block: number;
}

const { text, block } = Astro.props;
const marker = blockMarker(block);

// Blank lines separate paragraphs. Plain text — no markdown parsing.
const paragraphs = text
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<div class="prose">
  {
    paragraphs.map((paragraph, i) => (
      <p>
        {paragraph}
        {marker && i === paragraphs.length - 1 && (
          <span class="block-marker prose__marker">{marker}</span>
        )}
      </p>
    ))
  }
</div>

<style>
  /*
   * A text block is a break in the sequence rather than a caption, so it runs large
   * and centred, in a column narrower than the photographs either side of it.
   */
  .prose {
    --size: 2.125rem;
    width: 66.6667%;
    margin-inline: auto;
    color: var(--text-secondary);
    font-size: var(--size);
    /* Tight for the size: at 34px the body's 1.6 opens the lines up too far. */
    line-height: 1.3;
    text-align: center;
    text-wrap: pretty;
  }

  .prose p + p {
    margin-top: 1em;
  }

  /* Small enough not to read as part of the sentence it trails. */
  .prose__marker {
    font-size: 0.5em;
  }

  /* 768px: less room either side, so the column takes more of it at two thirds the size. */
  @media (max-width: 48rem) {
    .prose {
      width: 80%;
      font-size: calc(var(--size) * 2 / 3);
    }
  }
</style>
