---
import { getImage } from 'astro:assets';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/600.css';
import '../styles/global.css';
import { resolveTheme, googleFontsHref, varsToStyle } from '../lib/theme';
import { getSite } from '../lib/posts';
import { url } from '../lib/site';
import type { Theme } from '../lib/schema';

interface Props {
  /** Used verbatim as <title> and og:title — pages compose their own. */
  title: string;
  description: string;
  /** Share image. The home page passes its cover, album pages theirs. */
  image: ImageMetadata;
  theme?: Theme;
}

const { title, description, image, theme } = Astro.props;
const site = getSite();
const { vars, googleFonts } = resolveTheme(theme);
const fontsHref = googleFontsHref(googleFonts);

/*
 * Share cards want a fixed, reasonably sized landscape image, so every cover is
 * cropped to the same 1.91:1 that Facebook, Slack and iMessage all render at.
 * Absolute URLs are required here — a relative og:image is simply dropped.
 */
const share = await getImage({
  src: image,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareUrl = new URL(share.src, Astro.site);
---

<html lang="en" style={varsToStyle(vars)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={vars['--bg']} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.heading} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content={String(share.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(share.attributes.height ?? 630)} />
    <meta property="og:image:alt" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareUrl} />
    {
      /* Only pages whose theme names a non-default family reach out to Google. */
      fontsHref && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link rel="stylesheet" href={fontsHref} />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
