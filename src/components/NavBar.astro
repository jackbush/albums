---
import { getSite } from '../lib/posts';
import { url } from '../lib/site';

interface Props {
  /**
   * Which landmark to render as. The same bar opens and closes a post, so the
   * one at the top is the page header and the one at the bottom is its footer —
   * two landmarks rather than two identical navs.
   */
  as?: 'header' | 'footer' | 'nav';
  /**
   * Link to jackbush.github.io instead of the albums index. Hidden unless the visitor came
   * from there (its project links add ?from=home), which is remembered for the tab, so it's
   * still there after a look at an album.
   */
  home?: boolean;
}

const { as: Tag = 'header', home = false }: Props = Astro.props;
const site = getSite();
---

<Tag class="navbar" hidden={home}>
  <div class="container">
    <a class="meta navbar__link" href={home ? '/' : url()}>
      <span aria-hidden="true">&larr;</span> {home ? 'Jack Bush' : site.heading}
    </a>
  </div>
  {
    home && (
      <script is:inline>
        {
          const bar = document.currentScript.parentElement;
          let fromHome = new URLSearchParams(location.search).get('from') === 'home';
          try {
            if (fromHome) sessionStorage.setItem('albums:from', 'home');
            else fromHome = sessionStorage.getItem('albums:from') === 'home';
          } catch {}
          bar.hidden = !fromHome;
        }
      </script>
    )
  }
</Tag>

<style>
  .navbar {
    padding-block: 1.25rem;
  }

  .navbar__link {
    display: inline-block;
    color: var(--text-link);
    text-decoration: none;
  }

  .navbar__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
