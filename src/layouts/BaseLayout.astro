---
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/600.css';
import '../styles/global.css';
import { resolveTheme, googleFontsHref, varsToStyle } from '../lib/theme';
import { SITE, url } from '../lib/site';
import type { ThemeInput } from '../content.config';

interface Props {
  title: string;
  description: string;
  theme?: ThemeInput;
}

const { title, description, theme } = Astro.props;
const { vars, googleFonts } = resolveTheme(theme);
const fontsHref = googleFontsHref(googleFonts);
const pageTitle = title === SITE.title ? SITE.title : `${title} — ${SITE.title}`;
---

<html lang="en" style={varsToStyle(vars)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={vars['--bg']} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    {
      /* Only pages whose theme names a non-default family reach out to Google. */
      fontsHref && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link rel="stylesheet" href={fontsHref} />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
